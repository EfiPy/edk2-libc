[Defines]
  INF_VERSION                 = 0x00010016
  BASE_NAME                   = LibPythonCtypes
  FILE_GUID                   = CFA80FC9-EA9E-4F3C-82E5-D86491B443D0
  MODULE_TYPE                 = UEFI_DRIVER
  VERSION_STRING              = 0.1
  LIBRARY_CLASS               = LibPythonCtypes|UEFI_APPLICATION UEFI_DRIVER DXE_RUNTIME_DRIVER

  DEFINE PYTHON_VERSION       = 3.6.8

#
#  VALID_ARCHITECTURES        = X64
#

[Packages]
  StdLib/StdLib.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec 

[LibraryClasses]

[FixedPcd]
  gEfiMdePkgTokenSpaceGuid.PcdDebugPropertyMask|0x0F
  gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel|0x80000040

[Sources]

#Modules/ctypes
  Modules/_ctypes/_ctypes.c                     | MSFT  #
  Modules/_ctypes/callbacks.c                   | MSFT  #
  Modules/_ctypes/callproc.c                    | MSFT  #
  Modules/_ctypes/cfield.c                      | MSFT  #
  Modules/_ctypes/malloc_closure.c              | MSFT  #
  Modules/_ctypes/stgdict.c                     | MSFT  #
  Modules/_ctypes/libffi_msvc/ffi.c             | MSFT  #
  Modules/_ctypes/libffi_msvc/prep_cif.c        | MSFT  #

[Sources.IA32]
  Modules/_ctypes/libffi_msvc/win32.c           | MSFT #

[Sources.X64]
  Modules/_ctypes/libffi_msvc/win64.asm         | MSFT #

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /Oi- /wd4018 /wd4054 /wd4055 /wd4101 /wd4131 /wd4152 /wd4204 /wd4210 /wd4244 /wd4267 /wd4305 /wd4310 /wd4389 /wd4701 /wd4702 /wd4706 /wd4456 /wd4312 /wd4457 /wd4459 /wd4474 /wd4476 /I$(WORKSPACE)\AppPkg\Applications\Python\Python-3.6.8\PyMod-3.6.8\Include /I$(WORKSPACE)\AppPkg\Applications\Python\Python-3.6.8\Include /DHAVE_MEMMOVE /DUSE_PYEXPAT_CAPI /DXML_STATIC -D UEFI /DXML_POOR_ENTROPY
  GCC:*_*_*_CC_FLAGS = -Wno-unused-function -Wno-format -Wno-error -fno-strict-aliasing -I$(WORKSPACE)/AppPkg/Applications/Python/Python-3.6.8/Include -DHAVE_MEMMOVE -DUSE_PYEXPAT_CAPI -DXML_STATIC -DXML_POOR_ENTROPY

[BuildOptions.IA32]
  MSFT:*_*_*_CC_FLAGS = /DUEFI_MSVC_32

[BuildOptions.X64]
  MSFT:*_*_*_CC_FLAGS = /DUEFI_MSVC_64 /D _WIN64 /D _M_X64
